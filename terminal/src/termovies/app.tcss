Screen {
    background: #070b10;
    color: #e8f0f7;
}

/* ── Shell ─────────────────────────────────────────────────────────────── */

#masthead {
    height: 4;
    padding: 1 2;
    background: #0b121b;
    border-bottom: solid #1b2a38;
}
#brand {
    width: auto;
    min-width: 23;
    text-style: bold;
    color: #e8f0f7;
}
#tagline {
    width: 1fr;
    padding: 0 0 0 2;
    color: #7f90a2;
}
#status-strip {
    width: auto;
    height: 1;
}
.status-chip {
    width: auto;
    height: 1;
    padding: 0 1;
    margin: 0 0 0 1;
    background: #111d29;
    color: #7f90a2;
}
.status-chip.on {
    color: #a8ee78;
    background: #15271d;
}
#edition {
    width: 10;
    text-align: right;
    color: #647487;
}

#workspace { height: 1fr; }

#sidebar {
    width: 31;
    padding: 1 2;
    background: #0b121b;
    border-right: solid #1b2a38;
    overflow-y: auto;
}
.eyebrow {
    color: #a8ee78;
    text-style: bold;
    height: 1;
    margin: 1 0;
}
.field-label {
    color: #7f90a2;
    height: 1;
    margin-top: 1;
}
Select {
    width: 1fr;
    height: 3;
    margin-bottom: 1;
}
Select > SelectCurrent {
    background: #0a1119;
    border: tall #1b2a38;
    color: #e8f0f7;
    height: 3;
    padding: 0 1;
}
SelectCurrent > Static#label {
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}
Select:focus > SelectCurrent,
Select.-expanded > SelectCurrent {
    border: tall #a8ee78;
}
SelectOverlay {
    border: tall #2c4054;
    background: #0d1620;
}
SelectOverlay > .option-list--option-highlighted {
    background: #243c2b;
    color: #e4ffd0;
}
.sidebar-note {
    color: #647487;
    height: auto;
    margin: 0 0 1 0;
}
.sidebar-divider {
    height: 1;
    margin: 1 0;
    border-top: solid #1b2a38;
}
#sidebar Button {
    width: 1fr;
    margin: 0 0 1 0;
    background: #101b26;
    border: round #1b2a38;
    color: #c9d6e2;
}
#sidebar Button:hover {
    background: #152433;
    border: round #2e465a;
}
#sidebar Button.subtle {
    background: transparent;
    border: none;
    color: #7f90a2;
}
#sidebar Button.subtle:hover {
    color: #e8f0f7;
    background: #101b26;
}
#player-info {
    color: #a8ee78;
    height: auto;
    border-top: solid #1b2a38;
    padding-top: 1;
    margin-top: 1;
}

#content { padding: 1 2; }
#section-title { margin: 0 0 1 0; }

#search-bar {
    height: 3;
    margin-bottom: 1;
}
#search { width: 1fr; }
#search-button {
    width: 12;
    margin-left: 1;
}
#clear-search {
    width: 10;
    margin-left: 1;
}

#summary { height: 2; }
#result-count {
    width: 1fr;
    color: #e8f0f7;
    text-style: bold;
    content-align: left middle;
}
#playback {
    width: auto;
    color: #a8ee78;
    content-align: right middle;
}
#more {
    width: 20;
    min-width: 0;
    margin-left: 1;
}

#results-area {
    height: 1fr;
    min-height: 6;
}
#results {
    height: 1fr;
    background: #0a1018;
    border: round #1b2a38;
}
#results-empty {
    height: 1fr;
    align: center middle;
    background: #0a1018;
    border: round #1b2a38;
}
#empty-mark {
    width: 100%;
    height: auto;
    text-align: center;
    color: #a8ee78;
    text-style: bold;
}
#empty-title {
    width: 100%;
    height: auto;
    margin-top: 1;
    text-align: center;
    color: #e8f0f7;
    text-style: bold;
}
#empty-hint {
    width: 100%;
    max-width: 80;
    height: auto;
    margin-top: 1;
    text-align: center;
    color: #7f90a2;
}
#empty-actions {
    height: 3;
    margin-top: 1;
    align: center middle;
}
#empty-actions Button {
    width: auto;
    min-width: 14;
    margin: 0 1;
}

#detail {
    height: 14;
    margin-top: 1;
    padding: 1 2;
    background: #0d1620;
    border: round #1b2a38;
    border-left: thick #334d3a;
}
#detail.selected { border-left: thick #a8ee78; }
#media-title {
    height: auto;
    color: #f2f6fa;
    text-style: bold;
}
#media-meta {
    height: auto;
    max-height: 3;
    margin-top: 1;
    color: #91a3b5;
}
#overview-scroll {
    height: 1fr;
    margin-top: 1;
}
#media-overview {
    height: auto;
    color: #c3d0dc;
}
#episode-row {
    height: 3;
    margin-top: 1;
}
#episode-row Select {
    width: 1fr;
    margin-right: 1;
    margin-bottom: 0;
}
#detail-actions {
    height: 3;
    margin: 0;
}
#detail-actions Button {
    min-width: 9;
    width: auto;
    margin-right: 1;
}
#favorite {
    width: 17;
}
#favorite.active {
    background: #1f3b2a;
    color: #a8ee78;
    border: round #3b6448;
}
Button:disabled {
    background: #0c141d;
    color: #536474;
    border: round #1b2a38;
}
Button.-primary:disabled {
    background: #17251c;
    color: #536474;
    border: round #294032;
}
#status {
    height: 2;
    margin-top: 1;
    color: #7f90a2;
}

/* ── Tables, inputs and controls ──────────────────────────────────────── */

Input {
    background: #0a1119;
    border: tall #1b2a38;
}
Input:focus { border: tall #a8ee78; }
TextArea {
    background: #0a1119;
    border: tall #1b2a38;
}
TextArea:focus { border: tall #a8ee78; }
Button {
    background: #101b26;
    border: round #1b2a38;
    color: #d4e0eb;
}
Button:hover {
    background: #152433;
    border: round #2e465a;
}
Button.-primary {
    background: #a8ee78;
    border: round #a8ee78;
    color: #142012;
    text-style: bold;
}
Button.-primary:hover {
    background: #baf58f;
    border: round #baf58f;
}
Button:focus { text-style: bold reverse; }
Footer { background: #0b121b; }
Footer > .footer--key {
    background: #253d2a;
    color: #a8ee78;
}

DataTable {
    background: #0a1018;
}
DataTable > .datatable--header {
    background: #111d29;
    color: #91a3b5;
    text-style: bold;
}
DataTable > .datatable--cursor {
    background: #243c2b;
    color: #e4ffd0;
}
DataTable > .datatable--odd-row { background: #0d151e; }
Scrollbar {
    background: #0a1119;
    color: #2e465a;
}
Tabs { background: #0a1119; }
Tab {
    color: #7f90a2;
    background: #0a1119;
    padding: 0 2;
}
Tab:hover { color: #e8f0f7; }
Tab.-active {
    color: #142012;
    background: #a8ee78;
    text-style: bold;
}

/* ── Dialogs ──────────────────────────────────────────────────────────── */

ModalScreen {
    align: center middle;
    background: #05080c 82%;
}
.dialog {
    width: 94%;
    max-width: 150;
    height: 88%;
    padding: 1 2;
    background: #0d1620;
    border: round #2c4054;
}
.dialog-title {
    height: auto;
    color: #f2f6fa;
    text-style: bold;
}
.dialog-subtitle {
    height: auto;
    margin-bottom: 1;
    color: #7f90a2;
}
.section-label {
    height: 1;
    margin: 1 0;
    color: #a8ee78;
    text-style: bold;
}
.panel {
    height: auto;
    margin-bottom: 1;
    padding: 1 2;
    background: #0a1119;
    border: round #1b2a38;
}
.panel Label {
    height: 1;
    margin-bottom: 1;
    color: #c9d6e2;
}
.hint {
    height: auto;
    margin-top: 1;
    color: #647487;
}
.path {
    height: auto;
    color: #7f90a2;
}
.form-row {
    height: auto;
    margin-bottom: 1;
}
.form-col {
    width: 1fr;
    height: auto;
    margin-right: 1;
}
.form-row Input,
.form-row Select { width: 1fr; }
.actions {
    height: 3;
    margin-top: 1;
}
.actions Button {
    width: auto;
    min-width: 10;
    margin-right: 1;
}
#settings-status,
#addon-status,
#prompt-status,
#import-status {
    height: auto;
    min-height: 2;
    margin-top: 1;
    color: #91a3b5;
}

#settings-dialog { max-width: 100; }
#addons-dialog { max-width: 150; }
#currents-dialog { max-width: 150; height: 90%; }
#prompt-dialog { max-width: 150; height: 92%; }
#import-dialog { max-width: 120; height: 66%; }
#help-dialog { max-width: 100; height: 80%; }

/* Addons */
#addon-form {
    height: 3;
    margin-bottom: 1;
}
#addon-form Input { width: 1fr; }
#addon-form Button {
    width: 14;
    margin-left: 1;
}
#addon-table-wrap { height: 1fr; }
#addon-table { height: 1fr; }
#addon-empty {
    height: 1fr;
    align: center middle;
    padding: 1 2;
    text-align: center;
    color: #7f90a2;
    background: #0a1119;
    border: round #1b2a38;
}

/* Import */
#import-value { height: 8; }
#import-examples { color: #647487; }

/* Currents */
#current-table { height: 1fr; }
#current-detail-scroll {
    height: 12;
    margin-top: 1;
    padding-top: 1;
    border-top: solid #1b2a38;
}
#current-detail { height: auto; }
#current-selection {
    height: 2;
    margin-top: 1;
    color: #a8ee78;
}

/* Prompt */
#prompt-dialog TabbedContent { height: 1fr; }
#prompt-dialog TabPane { padding: 0 1; }
#prompt-question { height: 5; }
#prompt-output {
    height: 1fr;
    min-height: 6;
}
#prompt-currents {
    height: auto;
    margin-bottom: 1;
    color: #91a3b5;
}

/* Streams */
#streams-dialog {
    width: 98%;
    max-width: 220;
    height: 90%;
}
#streams-status {
    height: auto;
    min-height: 2;
    margin-bottom: 1;
    color: #91a3b5;
}
#stream-episode-row {
    height: 3;
    margin-bottom: 1;
}
#stream-episode-row Select {
    width: 1fr;
    margin-right: 1;
    margin-bottom: 0;
}
#stream-options {
    height: 3;
    margin-bottom: 1;
}
#stream-options Select {
    width: 1fr;
    margin-right: 1;
    margin-bottom: 0;
}
#reset-picker-filters { width: 10; }
#stream-filter { margin-bottom: 1; }
#stream-count {
    height: auto;
    margin-bottom: 1;
    color: #a8ee78;
}
#stream-table {
    height: 1fr;
    background: #0a1018;
    border: round #1b2a38;
}
#stream-description {
    height: 6;
    margin-top: 1;
    padding-top: 1;
    color: #c3d0dc;
    border-top: solid #1b2a38;
}

/* Help */
#help-scroll { height: 1fr; }
.help-table { height: auto; margin-bottom: 1; }
.help-notes { height: auto; color: #91a3b5; }

/* ── Compact layouts ──────────────────────────────────────────────────── */

Screen.compact #sidebar {
    width: 27;
    padding: 1;
}
Screen.compact #content { padding: 1; }
Screen.compact #tagline,
Screen.compact #status-strip { display: none; }
Screen.compact #edition {
    width: 1fr;
    text-align: right;
}
Screen.compact #clear-search { display: none; }
Screen.compact #inspire,
Screen.compact #favorite { display: none; }

Screen.short #masthead {
    height: 3;
    padding: 0 1;
}
Screen.short #sidebar { padding: 0 1; }
Screen.short .eyebrow { margin: 0; }
Screen.short #content { padding: 0 1; }
Screen.short #section-title { height: 1; }
Screen.short #search-bar { margin: 0; }
Screen.short #summary { height: 2; }
Screen.short #result-count { content-align: left middle; }
Screen.short #more {
    width: 15;
    margin-top: 0;
}
Screen.short #detail {
    height: 9;
    min-height: 9;
    margin-top: 0;
    padding: 0 1;
}
Screen.short #overview-scroll,
Screen.short #media-meta { display: none; }
Screen.short #results { min-height: 3; }
Screen.short #status {
    height: 1;
    margin: 0;
}
Screen.short #empty-actions { display: none; }

ModalScreen.small .dialog {
    height: 94%;
    padding: 0 1;
}
ModalScreen.small .dialog-subtitle,
ModalScreen.small .hint { display: none; }
ModalScreen.small .actions { margin-top: 0; }
ModalScreen.small #current-detail-scroll { height: 5; }
ModalScreen.small #current-selection {
    height: 1;
    margin: 0;
}
ModalScreen.small #addon-empty { padding: 0 1; }
ModalScreen.small #stream-description { display: none; }
ModalScreen.small #streams-status {
    max-height: 2;
    min-height: 1;
    margin: 0;
}
ModalScreen.small #stream-episode-row,
ModalScreen.small #stream-options,
ModalScreen.small #stream-filter { margin-bottom: 0; }
ModalScreen.small #stream-count { margin: 0; }
ModalScreen.small #import-value { height: 5; }
