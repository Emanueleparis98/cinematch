{
  "manifest_version": 3,
  "name": "CineMatch — Correnti del cinema",
  "version": "3.6.0",
  "description": "74 correnti del cinema, prompt in-chat, immagini TMDB automatiche e player con aggiornamenti integrati, addon e flussi HTTP/HLS.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "scripting", "clipboardWrite", "webRequest", "alarms"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.deepseek.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://api.themoviedb.org/*",
    "https://image.tmdb.org/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "side_panel": {"default_path": "panel.html"},
  "options_ui": {"page": "options.html", "open_in_tab": true},
  "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.deepseek.com/*", "https://claude.ai/*", "https://gemini.google.com/*"], "js": ["references.js", "overlay.js", "launcher.js", "enrich.js"], "run_at": "document_idle"}],
  "web_accessible_resources": [{"resources": ["watch.html", "cinema.html", "panel.html"], "matches": ["https://chatgpt.com/*", "https://chat.deepseek.com/*", "https://claude.ai/*", "https://gemini.google.com/*"]}],
  "action": {"default_title": "Apri CineMatch", "default_icon": "assets/cinematch.png"},
  "icons": {"16": "assets/cinematch.png", "32": "assets/cinematch.png", "48": "assets/cinematch.png", "128": "assets/cinematch.png"},
  "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; object-src 'none'; connect-src 'self' https: http:; media-src 'self' https: http: blob:; img-src 'self' data:; style-src 'self'; font-src 'self'; base-uri 'none'"}
}
