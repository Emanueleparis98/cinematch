  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Generate or save with one clear primary action.",
      "html": "<button class=\"ds-primary\">Genera il prompt</button>",
      "css": ".ds-primary{border:1px solid var(--line,#2c3b52);border-radius:11px;padding:10px 14px;font-size:14px;font-weight:650;cursor:pointer;transition:background 160ms ease,border-color 160ms ease,color 160ms ease;font-family:Manrope,Arial,sans-serif;background:#315fd1;border-color:#315fd1;color:#fff;font-weight:750}.ds-primary:hover{background:#3c6ee1;border-color:#3c6ee1}.ds-primary:focus-visible{outline:3px solid #91b5ff;outline-offset:2px}.ds-primary:disabled{opacity:.45;cursor:default}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}.ds-primary:disabled:hover{background:var(--surface,#151d2a);border-color:var(--line,#2c3b52)}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Supporting copy, insert and credential actions.",
      "html": "<button class=\"ds-secondary\">Copia</button>",
      "css": ".ds-secondary{border:1px solid var(--line,#2c3b52);border-radius:11px;padding:10px 14px;font-size:14px;font-weight:650;cursor:pointer;transition:background 160ms ease,border-color 160ms ease,color 160ms ease;font-family:Manrope,Arial,sans-serif;background:var(--surface,#151d2a);color:var(--text,#eef3ff)}.ds-secondary:hover{background:var(--raised,#1d293b);border-color:#537099}.ds-secondary:focus-visible{outline:3px solid #91b5ff;outline-offset:2px}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}}.ds-secondary:disabled:hover{background:var(--surface,#151d2a);border-color:var(--line,#2c3b52)}"
    },
    {
      "name": "Text Button",
      "kind": "button",
      "refersTo": "button-text",
      "description": "Quiet supporting action alongside form controls.",
      "html": "<button class=\"ds-text\">Azzera filtri</button>",
      "css": ".ds-text{border:1px solid var(--line,#2c3b52);border-radius:11px;padding:10px 14px;font-size:14px;font-weight:650;cursor:pointer;transition:background 160ms ease,border-color 160ms ease,color 160ms ease;font-family:Manrope,Arial,sans-serif;background:transparent;border-color:transparent;padding:5px 3px;font-size:11px;color:var(--accent,#9cbbff)}.ds-text:hover{background:var(--raised,#1d293b);border-color:#537099}.ds-text:focus-visible{outline:3px solid #91b5ff;outline-offset:2px}@media(prefers-reduced-motion:reduce){.ds-text{transition:none}}.ds-text:disabled:hover{background:var(--surface,#151d2a);border-color:var(--line,#2c3b52)}"
    },
    {
      "name": "Labeled Field",
      "kind": "input",
      "refersTo": "field",
      "description": "A persistent label above a dark surface field.",
      "html": "<label class=\"ds-label\">La tua richiesta<input class=\"ds-field\" placeholder=\"Che cosa ti incuriosisce?\"></label>",
      "css": ".ds-label{display:block;font-size:11px;font-weight:750;color:var(--muted,#a8b6cc);font-family:Manrope,Arial,sans-serif;}.ds-field{display:block;width:100%;margin-top:7px;padding:11px 12px;border:1px solid var(--line,#2c3b52);border-radius:11px;background:var(--surface,#151d2a);color:var(--text,#eef3ff);font-size:13px;font-weight:450;caret-color:var(--accent,#9cbbff);font-family:Manrope,Arial,sans-serif;}.ds-field::placeholder{color:#9aaac2;opacity:1}.ds-field:focus-visible{outline:3px solid #91b5ff;outline-offset:2px}"
    },
    {
      "name": "Segmented Navigation",
      "kind": "nav",
      "refersTo": "tab-selected",
      "description": "Two equal-weight sections with one selected view.",
      "html": "<div class=\"ds-tabs\" role=\"tablist\" aria-label=\"Sezioni\"><button class=\"ds-tab\" role=\"tab\" aria-selected=\"true\">Esplora</button><button class=\"ds-tab\" role=\"tab\" aria-selected=\"false\" tabindex=\"-1\">La tua richiesta</button></div>",
      "css": ".ds-tabs{display:flex;gap:4px;padding:5px;background:#121b2c;border:1px solid #25334a;border-radius:13px;font-family:Manrope,Arial,sans-serif;}.ds-tab{flex:1;border:1px solid transparent;border-radius:9px;padding:9px 6px;background:transparent;color:var(--muted,#a8b6cc);font:750 12px Manrope,Arial,sans-serif;cursor:pointer;transition:background 160ms ease}.ds-tab[aria-selected=true]{background:var(--surface,#151d2a);color:var(--accent,#9cbbff);box-shadow:0 2px 5px #00000020}.ds-tab:hover{border-color:#537099}.ds-tab:focus-visible{outline:3px solid #91b5ff;outline-offset:2px}@media(prefers-reduced-motion:reduce){.ds-tab{transition:none}}"
    },
    {
      "name": "Selection Chip",
      "kind": "chip",
      "refersTo": "selection-chip",
      "description": "A removable selected movement.",
      "html": "<button class=\"ds-chip\">Neorealismo italiano<svg width=\"12\" height=\"12\" viewBox=\"0 0 12 12\" aria-hidden=\"true\"><path d=\"M3 3l6 6M9 3L3 9\"/></svg></button>",
      "css": ".ds-chip{display:inline-flex;align-items:center;gap:7px;font:650 11px Manrope,Arial,sans-serif;padding:6px 9px;border:1px solid transparent;border-radius:8px;background:#20375c;color:#c2d4ff;cursor:pointer;transition:background 160ms ease,border-color 160ms ease}.ds-chip svg{fill:none;stroke:currentColor;stroke-width:1.8}.ds-chip:hover{border-color:#537099}.ds-chip:focus-visible{outline:3px solid #91b5ff;outline-offset:2px}@media(prefers-reduced-motion:reduce){.ds-chip{transition:none}}"
    },
    {
      "name": "Selected Editorial Row",
      "kind": "custom",
      "refersTo": "movement-row-selected",
      "description": "Checkbox selection with title and chronological metadata.",
      "html": "<div class=\"ds-row\"><input class=\"ds-check\" aria-label=\"Seleziona Neorealismo italiano\" type=\"checkbox\" checked><div><button class=\"ds-row-title\">Neorealismo italiano</button><span class=\"ds-row-meta\">Movimento · 1943–1952 · Italia</span></div></div>",
      "css": ".ds-row{display:grid;grid-template-columns:24px minmax(0,1fr);gap:10px;padding:16px 10px;border-bottom:1px solid var(--line,#2c3b52);color:var(--text,#eef3ff);font-family:Manrope,Arial,sans-serif;}.ds-check{appearance:none;position:relative;display:inline-grid;place-content:center;width:20px;height:20px;flex:none;padding:0;margin:2px 0 0;border:1.5px solid #52647e;border-radius:6px;background:#111a28;cursor:pointer;vertical-align:middle;transition:background 140ms ease,border-color 140ms ease}.ds-check::after{content:\"\";width:9px;height:5px;border-left:2px solid #fff;border-bottom:2px solid #fff;transform:translateY(-1px) rotate(-45deg) scale(0);transition:transform 130ms cubic-bezier(.2,.8,.2,1)}.ds-check:hover{border-color:#9cbbff}.ds-check:checked{background:#315fd1;border-color:#6e94f0}.ds-check:checked::after{transform:translateY(-1px) rotate(-45deg) scale(1)}.ds-check:disabled{cursor:default;opacity:.4}.ds-check:focus-visible{outline:3px solid #91b5ff;outline-offset:2px}@media(prefers-reduced-motion:reduce){.ds-check,.ds-check::after{transition:none}}.ds-row-title{display:block;border:0;border-radius:0;background:none;text-align:left;padding:0;font:750 14px/1.5 Manrope,Arial,sans-serif;color:inherit;cursor:pointer}.ds-row-title:hover{color:var(--accent,#9cbbff)}.ds-row-title:focus-visible{outline:3px solid #91b5ff;outline-offset:2px}.ds-check:focus-visible{outline:3px solid #91b5ff;outline-offset:2px}.ds-row-meta{display:block;font-size:11px;line-height:1.7;margin-top:5px;color:var(--muted,#a8b6cc)}.ds-row:has(input:checked){background:#1c2e4d;border-radius:10px;border-color:transparent}"
    },
    {
      "name": "Checkbox",
      "kind": "input",
      "refersTo": "checkbox",
      "description": "Native input semantics with a custom dark square and white tick.",
      "html": "<label class=\"ds-check-label\"><input class=\"ds-check\" type=\"checkbox\" checked> Ricorda su questo dispositivo</label>",
      "css": ".ds-check{appearance:none;position:relative;display:inline-grid;place-content:center;width:20px;height:20px;flex:none;padding:0;margin:2px 0 0;border:1.5px solid #52647e;border-radius:6px;background:#111a28;cursor:pointer;vertical-align:middle;transition:background 140ms ease,border-color 140ms ease}.ds-check::after{content:\"\";width:9px;height:5px;border-left:2px solid #fff;border-bottom:2px solid #fff;transform:translateY(-1px) rotate(-45deg) scale(0);transition:transform 130ms cubic-bezier(.2,.8,.2,1)}.ds-check:hover{border-color:#9cbbff}.ds-check:checked{background:#315fd1;border-color:#6e94f0}.ds-check:checked::after{transform:translateY(-1px) rotate(-45deg) scale(1)}.ds-check:disabled{cursor:default;opacity:.4}.ds-check:focus-visible{outline:3px solid #91b5ff;outline-offset:2px}@media(prefers-reduced-motion:reduce){.ds-check,.ds-check::after{transition:none}}.ds-check-label{display:flex;align-items:center;gap:9px;color:var(--text,#eef3ff);font:550 12px/1.55 Manrope,Arial,sans-serif}"
    },
    {
      "name": "Choice Picker Trigger",
      "kind": "input",
      "refersTo": "picker-trigger",
      "description": "Styled combobox value; controls.js supplies runtime keyboard and popover behavior.",
      "html": "<button class=\"ds-picker-trigger\" role=\"combobox\" aria-label=\"Tipo\" aria-haspopup=\"listbox\" aria-expanded=\"false\"><span class=\"ds-picker-value\">Tutte le tipologie</span><svg class=\"ds-picker-chevron\" width=\"15\" height=\"15\" viewBox=\"0 0 20 20\" aria-hidden=\"true\"><path d=\"M5 8l5 5 5-5\"/></svg></button>",
      "css": ".ds-picker-trigger{display:flex;align-items:center;justify-content:space-between;gap:12px;width:100%;min-width:0;min-height:43px;padding:11px 12px;background:var(--surface,#151d2a);border:1px solid var(--line,#2c3b52);border-radius:11px;color:var(--text,#eef3ff);font:500 13px/1.55 Manrope,Arial,sans-serif;text-align:left;cursor:pointer;transition:background 160ms ease,border-color 160ms ease}.ds-picker-trigger:hover{background:#1b283b;border-color:#537099}.ds-picker-trigger[aria-expanded=true]{background:#1b2a42;border-color:#83a8ff}.ds-picker-trigger:disabled{cursor:default;opacity:.45}.ds-picker-trigger:focus-visible{outline:3px solid #91b5ff;outline-offset:2px}.ds-picker-value{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0}.ds-picker-chevron{flex:none;fill:none;stroke:#afc2e2;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;transition:transform 140ms ease}.ds-picker-trigger[aria-expanded=true] .ds-picker-chevron{transform:rotate(180deg)}@media(prefers-reduced-motion:reduce){.ds-picker-trigger,.ds-picker-chevron{transition:none}}"
    },
    {
      "name": "Choice Picker Menu",
      "kind": "custom",
      "refersTo": "picker-menu",
      "description": "Opaque listbox with distinct active and committed states; runtime positions it in the top layer.",
      "html": "<div class=\"ds-picker-menu\" role=\"listbox\" aria-label=\"Usa con\"><button class=\"ds-picker-option\" role=\"option\" aria-selected=\"true\">ChatGPT<svg width=\"15\" height=\"15\" viewBox=\"0 0 20 20\" aria-hidden=\"true\"><path d=\"M4 10l4 4 8-8\"/></svg></button><button class=\"ds-picker-option ds-picker-active\" role=\"option\" aria-selected=\"false\">DeepSeek<svg width=\"15\" height=\"15\" viewBox=\"0 0 20 20\" aria-hidden=\"true\"><path d=\"M4 10l4 4 8-8\"/></svg></button><button class=\"ds-picker-option\" role=\"option\" aria-selected=\"false\">Claude<svg width=\"15\" height=\"15\" viewBox=\"0 0 20 20\" aria-hidden=\"true\"><path d=\"M4 10l4 4 8-8\"/></svg></button></div>",
      "css": ".ds-picker-menu{padding:6px;border:1px solid #3d526f;border-radius:13px;background:#172235;color:#eef3ff;box-shadow:0 14px 40px #0007;max-height:320px;overflow:auto;scrollbar-width:thin;scrollbar-color:#516789 transparent;font-family:Manrope,Arial,sans-serif}.ds-picker-option{display:flex;align-items:center;justify-content:space-between;gap:14px;width:100%;min-height:39px;border:0;border-radius:8px;padding:10px 11px;color:#dce7fa;background:transparent;font:550 12px/1.5 Manrope,Arial,sans-serif;text-align:left;cursor:pointer}.ds-picker-option:hover,.ds-picker-option.ds-picker-active{background:#2a3a56}.ds-picker-option[aria-selected=true]{background:#263f6a;color:#eef4ff}.ds-picker-option:focus-visible{outline:3px solid #91b5ff;outline-offset:2px}.ds-picker-option:disabled{opacity:.4;cursor:default}.ds-picker-option svg{flex:none;fill:none;stroke:#a9c6ff;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;visibility:hidden}.ds-picker-option[aria-selected=true] svg{visibility:visible}"
    }
  ],
  "narrative": {
    "northStar": "The Contemporary Film Journal",
    "overview": "A contemporary independent film journal: deep graphite, navy surfaces and restrained cobalt make the browser extension feel clear, precise and inviting. Pale blue links and selection details remain legible on the dark canvas. Manrope gives compact navigation and editorial reading one consistent voice.\n\nThis system governs the browser panel, its expanded tab and the TMDB connection page. These extension-owned surfaces are dark only. Inline media belong visually to the host chat and inherit its font and colors; the extension does not change the remote account theme. The native Windows app and Rust CLI retain their legacy LUMEN styling outside this redesign and are not sources of browser tokens.",
    "keyCharacteristics": [
      "Dark graphite and navy with cobalt actions and light-blue links.",
      "Flat chronological rows, clear dividers and compact task controls.",
      "Locally hosted Manrope for extension-owned surfaces.",
      "Styled native checkbox inputs and keyboard-accessible popover choices.",
      "Transparent, unboxed photographs immediately below the recognized title."
    ],
    "rules": [
      {
        "name": "The Dark Surface Rule",
        "body": "Keep the panel, connection page and their menus dark. Inline media inherit the host chat theme.",
        "section": "colors"
      },
      {
        "name": "The Action Accent Rule",
        "body": "Use cobalt for primary actions and checked controls; use pale blue for links, selected navigation and focus. Reading surfaces remain neutral.",
        "section": "colors"
      },
      {
        "name": "The Native Answer Rule",
        "body": "Inline media inherit the chat font and colors. Leave the original answer text and heading intact, with no enclosing card or duplicate title.",
        "section": "typography"
      },
      {
        "name": "The Flat Reading Rule",
        "body": "Separate editorial rows with spacing and fine rules. Reserve soft shadows for selected navigation, the action dock and floating choice menus.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the browser dark tokens and locally hosted Manrope on extension-owned pages.",
      "Do place media immediately below the recognized title line and before the description.",
      "Do let names wrap at spaces in caption columns wider than their portraits.",
      "Do keep keyboard focus visible, preserve picker keyboard operation and respect reduced-motion preferences.",
      "Do preserve native chat typography and omit unavailable or uncertain media quietly.",
      "Do retain source attribution and provenance for imagery and bundled assets."
    ],
    "donts": [
      "Don't reintroduce a light extension theme or the legacy LUMEN palette and serif typography.",
      "Don't inject controls, configuration forms or duplicate film headings into AI answers.",
      "Don't force person names to break inside words to match portrait width.",
      "Don't force the external chat to adopt the panel theme.",
      "Don't replace the styled checkbox and popover choice surfaces with operating-system menu styling."
    ]
  }
}
