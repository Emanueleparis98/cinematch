  "narrative": {
    "northStar": "The Contemporary Film Journal",
    "overview": "A contemporary independent film journal: cool paper, graphite text and a restrained cobalt accent make the browser extension feel clear, precise and inviting. Manrope gives the compact navigation and editorial reading one consistent voice.\n\nThis system governs the browser panel, its expanded tab and the TMDB connection page. Inline media belong visually to the host chat and inherit its font and colors. The native Windows app and Rust CLI retain their legacy LUMEN styling outside this redesign; they are not a source of browser tokens.",
    "keyCharacteristics": [
      "Cool white and graphite with cobalt reserved for actions and selection.",
      "Flat chronological rows, clear dividers and compact task controls.",
      "Locally hosted Manrope for extension-owned surfaces.",
      "Transparent, unboxed media that inherit the host chat."
    ],
    "rules": [
      {
        "name": "The Action Accent Rule",
        "body": "Use cobalt for primary actions, links, selection and focus. Reading surfaces remain cool and neutral.",
        "section": "colors"
      },
      {
        "name": "The Native Answer Rule",
        "body": "Inline media inherit the chat font and colors. Leave the original answer text and heading intact, with no enclosing card or duplicate title.",
        "section": "typography"
      },
      {
        "name": "The Flat Reading Rule",
        "body": "Separate editorial rows with spacing and fine rules. Reserve the existing soft shadows for the selected tab and the action dock.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the browser tokens and locally hosted Manrope on extension-owned pages.",
      "Do let names wrap at spaces in caption columns wider than their portraits.",
      "Do keep keyboard focus visible and respect reduced-motion preferences.",
      "Do preserve native chat typography and omit unavailable or uncertain media quietly."
    ],
    "donts": [
      "Don't revive the legacy LUMEN palette or serif typography in browser surfaces.",
      "Don't inject controls, configuration forms or duplicate film headings into AI answers.",
      "Don't force person names to break inside words to match portrait width.",
      "Don't treat the panel’s light palette as a theme for the external chat."
    ]
  }
}
