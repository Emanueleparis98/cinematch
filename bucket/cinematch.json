{
  "version": "0.3.1",
  "description": "Film, series, anime, TV and cinema prompts in your terminal",
  "homepage": "https://github.com/Emanueleparis98/cinematch",
  "license": "MIT",
  "depends": "main/uv",
  "url": "https://github.com/Emanueleparis98/cinematch/releases/download/terminal-v0.3.1/CineMatch-0.3.1-scoop.zip",
  "hash": "bc6568d680d3f836bc50b4b21b4f8fd81dc0de3806b06ae83414f5fff3b1e0cc",
  "installer": {
    "script": [
      "& uv venv --python 3.13 \"$dir\\venv\"",
      "if ($LASTEXITCODE -ne 0) { throw 'Cannot create CineMatch environment' }",
      "& uv pip install --python \"$dir\\venv\\Scripts\\python.exe\" \"$dir\\cinematch-0.3.1-py3-none-any.whl\"",
      "if ($LASTEXITCODE -ne 0) { throw 'Cannot install CineMatch' }"
    ]
  },
  "bin": "venv\\Scripts\\cinematch.exe",
  "notes": "Install mpv or VLC for video playback. Run: cinematch",
  "checkver": {
    "github": "https://github.com/Emanueleparis98/cinematch",
    "regex": "terminal-v([\\d.]+)"
  }
}
